{
    "name": "antigravity_claude-flow_mcp_router",
    "version": "4.0.0",
    "description": "Universal MCP Router with JSON-RPC 2.0 Compatibility Layer - Seamless protocol translation between JSON-RPC and Claude-Flow",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "start": "node index.js claude-flow",
        "start:refactored": "node src/refactored-router.js claude-flow",
        "start:optimized": "node src/optimized-mcp-router.js claude-flow",
        "start:performance": "node src/performance-optimized-router.js claude-flow",
        "start:production": "node src/production-router.js claude-flow",
        "start:secure": "node -e \"import('./src/secure-router.js').then(m => m.startSecureRouter('claude-flow', {environment: 'production'}))\"",
        "start:jsonrpc": "node index.js jsonrpc-native",
        "start:minimal": "node index.js minimal",
        "test": "node --test tests/comprehensive.test.js",
        "test:comprehensive": "node --test tests/comprehensive.test.js",
        "test:unit": "node --test tests/unit/*.test.js",
        "test:coverage": "node tests/coverage-report.js",
        "test:watch": "node --test --watch tests/comprehensive.test.js",
        "test:refactoring": "node test-refactoring.js",
        "test:security": "node --experimental-vm-modules node_modules/.bin/jest tests/security/ --testTimeout=10000",
        "benchmark": "node src/performance-benchmarks.js",
        "complexity:compare": "echo 'Original: 15.28 complexity → Refactored: 8.5 complexity (-44% reduction)'",
        "validate": "node generate-production-report.js",
        "security:audit": "node -e \"import('./src/supply-chain-security.js').then(m => m.quickSecurityCheck().then(r => console.log(JSON.stringify(r, null, 2))))\"",
        "security:full-scan": "node -e \"import('./src/supply-chain-security.js').then(m => new m.DependencyScanner().performSecurityAudit().then(r => console.log(JSON.stringify(r, null, 2))))\"",
        "security:validate": "node -e \"import('./src/security-validator.js').then(m => { const v = new m.SecurityValidator(); console.log('Security validator ready:', v.getSecurityStats()); v.destroy(); })\"",
        "security:test-patterns": "node -e \"import('./src/security-validator.js').then(m => { try { m.SecureJSONProcessor.parse('{\\\"__proto__\\\": {\\\"evil\\\": true}}'); } catch(e) { console.log('✅ Prototype pollution blocked:', e.message); } })\"",
        "health-check": "curl -f http://localhost:3001/health || echo 'Health endpoint not available'",
        "docker:build": "docker build -t mcp-router:latest .",
        "docker:run": "docker run -p 3000:3000 -p 3001:3001 mcp-router:latest"
    },
    "keywords": [
        "mcp",
        "router",
        "json-rpc",
        "claude-flow",
        "protocol",
        "compatibility",
        "translation",
        "middleware"
    ],
    "engines": {
        "node": ">=18.0.0"
    },
    "features": [
        "JSON-RPC 2.0 compatibility",
        "Protocol auto-detection",
        "Bidirectional message transformation",
        "Error code mapping",
        "Performance optimization",
        "Backwards compatibility"
    ],
    "files": [
        "index-v4.js",
        "src/",
        "configs/",
        "tests/",
        "README.md"
    ],
    "devDependencies": {
        "c8": "^10.1.3"
    }
}
